PORT=3001
JWT_SECRET=your_jwt_secret_key
DATABASE_URL=postgresql://user:password@localhost:5432/kingsol_db

# ==========================================
# Hostinger SMTP Configuration
# ==========================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sales@kingsol.in
SMTP_PASS=your_hostinger_email_or_app_password
SMTP_FROM="Kingsol Energy" <sales@kingsol.in>

# ==========================================
# Notification & Routing Recipient Inboxes
# ==========================================
SALES_EMAIL=sales@kingsol.in
HR_EMAIL=hr@kingsol.in

# Legacy variable aliases (backward compatibility)
EMAIL_USER=sales@kingsol.in
EMAIL_APP_PASSWORD=your_hostinger_email_or_app_password
ADMIN_EMAIL=sales@kingsol.in
EMAIL_RECEIVER=sales@kingsol.in
ADMIN_ALERT_EMAIL=sales@kingsol.in

